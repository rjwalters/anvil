{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:openssf-scorecard',
    ':dependencyDashboard',
  ],
  mode: 'full',
  minimumReleaseAge: '14 days',
  osvVulnerabilityAlerts: true,
  automerge: false,
  draftPR: true,
  schedule: [
    'before 10am on monday',
  ],
  timezone: 'UTC',
  rangeStrategy: 'bump',
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 10am on monday',
    ],
  },
  prConcurrentLimit: 5,
  fetchChangeLogs: 'pr',
  packageRules: [
    {
      groupName: 'python minor/patch dependencies',
      matchManagers: [
        'pep621',
        'poetry',
        'uv',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      matchManagers: [
        'pep621',
        'poetry',
        'uv',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
  ],
  ignorePaths: [
    'vendor/**',
    '.claude/**',
    'infra/pulumi/**',
  ],
  vulnerabilityAlerts: {
    enabled: true,
  },
}
