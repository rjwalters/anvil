.loom/stuck-history.json
.loom/alerts.json
.loom/health-metrics.json
.loom/progress/

# Host-local Loom config tier (worktree.root and other host-specific
# overrides). Deliberately NOT committed: it holds absolute paths that are
# only valid on this machine. See Loom's docs/design/config-resolution-tiers.md
# — `.loom-local/local.json` is the "Local" tier and outranks .loom/config.json.
.loom-local/

# Exception: the config-resolver conformance fixture needs a real
# .loom-local/ directory to exercise the "Local" config tier by name (see
# .loom/scripts/tests/fixtures/config_resolver/README.md). Without this,
# the .loom-local/ rule above silently un-adds any file placed under a test
# fixture's .loom-local/ subdirectory. Decision recorded per #1035.
!**/tests/fixtures/**/.loom-local/
!**/tests/fixtures/**/.loom-local/**

