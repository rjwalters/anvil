# Anvil is a library consumed via flexible version ranges (pyproject.toml's
# pydantic>=2.0 base dep), not a pinned deployment — no committed lockfile
# to keep in sync across contributors/CI. Decision recorded per #1035.
uv.lock

# Env
.env
.env.local

